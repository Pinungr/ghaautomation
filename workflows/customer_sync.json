{
  "name": "customer_sync",
  "version": "1.0.0",
  "schedule": "0 2 * * *",
  "steps": [
    { "id": "extract", "type": "source", "table": "customers" },
    { "id": "transform", "type": "map", "drop_nulls": true },
    { "id": "load", "type": "sink", "target": "warehouse.customers" },
    { "id": "load", "type": "map", "target": "warehouse.agents" },
    { "id": "load", "type": "sinc", "target": "warehouse.managers" }
  ]
}
